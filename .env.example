# Smart LLM Router Configuration
# Copy this file to .env and fill in your values. Keys align with config/__init__.py.

# Backend selection: "ollama" (default) or "transformers"
LLM_BACKEND=ollama

# Model routes
FAST_MODEL_PATH=llama2:7b
STRONG_MODEL_PATH=llama2:13b
JUDGE_MODEL_PATH=llama2:13b

# Execution
MODEL_DEVICE=auto              # auto|cpu|cuda (used for transformers backend)
OLLAMA_BIN_PATH=ollama         # full path if not on PATH

# Routing + judge thresholds
ROUTING_PROMPT_LENGTH_THRESHOLD=200
JUDGE_CORRECTNESS_THRESHOLD=5

# Limits + cache
MAX_TOKENS=1024
CACHE_TTL_SECONDS=3600

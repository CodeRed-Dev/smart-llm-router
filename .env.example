# Smart LLM Router Configuration
# Copy this file to .env and fill in your values

# OpenAI API Configuration (for Codex CLI)
# Get your key from https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# Ollama Configuration (for LLM Router Service)
FAST_MODEL_NAME=llama2:7b
STRONG_MODEL_NAME=llama2:13b
JUDGE_MODEL_NAME=llama2:7b
OLLAMA_BASE_URL=http://localhost:11434

# LLM Parameters
LLM_TIMEOUT_SECONDS=30
MAX_RETRIES=3
CACHE_TTL_SECONDS=3600

# Database
DATABASE_PATH=metrics.db
